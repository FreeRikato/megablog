{
	"name": "megablog",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "npm run clean && tsx esbuild.config.ts",
		"start": "node dist/server.js",
		"type-check": "tsc --noEmit",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"clean": "rm -rf dist",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"dependencies": {
		"express": "^5.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/express": "^5.0.6",
		"@types/node": "^24.10.2",
		"esbuild": "^0.27.1",
		"husky": "^9.0.0",
		"lint-staged": "^15.2.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
